<style>
  .profile-avatar {
    width: 17rem;
  }
  @media (width >= 40rem) {
    .profile-avatar {
      width: 30rem;
    }
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  /* ---------- Animation only ---------- */
  .fk {
    opacity: 0;
    animation: fk 1.9s infinite ease-in-out;
  }
  @keyframes fk {
    0%,
    55%,
    100% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
  }
  .curve {
    stroke-dasharray: 170;
    animation: draw 6s infinite ease-in-out;
  }
  .c2 {
    animation-delay: 0.6s;
  }
  @keyframes draw {
    0% {
      stroke-dashoffset: 170;
    }
    65%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  .ping {
    animation: ping 2.4s infinite;
  }
  @keyframes ping {
    0%,
    60% {
      opacity: 0;
      r: 1;
    }
    75% {
      opacity: 1;
      r: 5;
    }
    100% {
      opacity: 0;
      r: 1;
    }
  }
  .node {
    animation: pulse 2.4s infinite ease-in-out;
  }
  .n2 {
    animation-delay: 0.4s;
  }
  .n3 {
    animation-delay: 0.8s;
  }
  .n4 {
    animation-delay: 1.2s;
  }
  .n5 {
    animation-delay: 1.6s;
  }
  .n6 {
    animation-delay: 2s;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  .wave {
    animation: wave 2.2s linear infinite;
  }
  @keyframes wave {
    to {
      transform: translateX(-16px);
    }
  }
  .drop {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: drop 2.4s infinite;
  }
  .d2 {
    animation-delay: -1.2s;
  }
  @keyframes drop {
    0% {
      transform: translateY(0) scale(0.2);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    30% {
      transform: translateY(0) scale(1);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    72% {
      transform: translateY(86px) scale(1);
      opacity: 1;
    }
    73%,
    100% {
      transform: translateY(86px) scale(1);
      opacity: 0;
    }
  }
  .ripple {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: rip 2.4s infinite ease-out;
  }
  .r2 {
    animation-delay: -1.2s;
  }
  @keyframes rip {
    0%,
    72% {
      opacity: 0;
      transform: scale(0.15);
    }
    74% {
      opacity: 0.9;
      transform: scale(0.25);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  .bub {
    animation: bub 3.2s infinite ease-in;
  }
  .b2 {
    animation-delay: -1.6s;
  }
  @keyframes bub {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-16px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
    }
    .fk {
      opacity: 0;
    }
    .curve {
      stroke-dashoffset: 0;
    }
  }
</style>
