---
import { getCollection } from "astro:content"

import { PROFILE, SITE } from "@site-config"
import { loadSelectedPublications } from "@/lib/publications/loader"
import Layout from "@/layouts/Layout.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import Section from "@/components/layout/Section.astro"
import Profile from "@/components/profile/Profile.astro"
import PubCard from "@/components/publications/PubCard.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import TechStack from "@/components/projects/TechStack.astro"
import techStack from "@/content/tech-stack.json"

import "@/styles/callout.css"

const {
  home: { careerHighlightCount, educationHighlightCount, publicationCount },
} = SITE

const careerHighlights =
  careerHighlightCount > 0 ? await getCollection("experience") : []
const educationHighlights =
  careerHighlightCount > 0 ? await getCollection("education") : []
const cvHref =
  typeof PROFILE.links.cv === "object"
    ? PROFILE.links.cv?.href
    : PROFILE.links.cv
const selectedPublications =
  publicationCount > 0
    ? (await loadSelectedPublications()).slice(0, publicationCount)
    : []
---

<Layout title="Home">
  <Profile profile={PROFILE} />

  {selectedPublications.length > 0 && (
      <Section title="Publications" moreLink="/publications" moreText="">
        <CardGroup class="selected-publications">
          {selectedPublications.map((pub) => (
            <PubCard pub={pub} filterableTags={false} />
          ))}
        </CardGroup>
      </Section>
    )}

  {careerHighlights.length > 0 && (
      <Section title="Career highlights" moreLink={`${import.meta.env.BASE_URL}/assets/Nabigha_Mogharbel_CV.pdf`} moreText="see CV →">
        <ExperienceTimeline
          entries={careerHighlights}
          limit={careerHighlightCount}
          itemClass="home-experience-content"
        />
      </Section>
    )}

  {educationHighlights.length > 0 && (
      <Section title="Education highlights" moreLink={`${import.meta.env.BASE_URL}/assets/Nabigha_Mogharbel_CV.pdf`} moreText="see CV →">
        <ExperienceTimeline
          entries={educationHighlights}
          limit={educationHighlightCount}
          itemClass="home-education-content"
        />
      </Section>
    )}

  <Section title="Skills" class="tech-stack-section">
    <TechStack {...techStack} />
  </Section>
</Layout>

<style>
  .selected-publications {
    gap: var(--space-s);
  }

  .latest-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .latest-posts-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  :global(.home-arrow-button span[aria-hidden="true"]) {
    display: inline-block;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  :global(.home-arrow-button:hover span[aria-hidden="true"]) {
    transform: translateX(0.25rem);
  }

  :global(.home-experience-content) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.home-update-content) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;

    @media (width >= 48rem) {
      -webkit-line-clamp: 3;
    }
  }
</style>
